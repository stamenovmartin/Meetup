# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-here

# Database
DATABASE_URL=sqlite:///instance/meetup.db
# For PostgreSQL: postgresql://user:password@localhost:5432/meetup_db

# Admin
ADMIN_EMAILS=admin@example.com,admin2@example.com

# GNN Settings
GNN_GRAPH_PATH=graph_construction/graph_data/event_similarity_graph.pt
GNN_ALPHA=0.6

# Scraper Settings
SCRAPER_TIMEOUT=1800
SCRAPER_HEADLESS=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# JWT
JWT_ACCESS_TOKEN_EXPIRES=604800

# Port
PORT=5000
